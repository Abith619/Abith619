<?xml version="1.0" encoding="UTF-8"?>
<odoo>
        <record id="view_whatsapp_incoming_message_list" model="ir.ui.view">
            <field name="name">whatsapp.incoming.message.list</field>
            <field name="model">whatsapp.incoming.message</field>
            <field name="arch" type="xml">
                <list string="Incoming Messages">
                    <field name="sender"/>
                    <field name="content"/>
                    <field name="timestamp"/>
                </list>
            </field>
        </record>

        <record id="view_whatsapp_incoming_message_form" model="ir.ui.view">
            <field name="name">whatsapp.incoming.message.form</field>
            <field name="model">whatsapp.incoming.message</field>
            <field name="arch" type="xml">
                <form string="Incoming Message">
                    <sheet>
                        <group>
                            <field name="sender"/>
                            <field name="content"/>
                            <field name="timestamp"/>
                            <field name="wa_account_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_whatsapp_incoming_message" model="ir.actions.act_window">
            <field name="name">Incoming Messages</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">whatsapp.incoming.message</field>
            <field name="view_mode">list,form</field>
        </record>

</odoo>