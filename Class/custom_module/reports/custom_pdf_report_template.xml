<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_custom_report_details">
        <t t-call="web.html_container">
           <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                            <h2 class='text-center'>Custom Report</h2>
                        <br></br>
                        <div class="row mt-4 mb-4">
                            <div class="col-6 text-left">
                                <p>
                                    Name :
                                    <span t-field="o.name"/>
                                </p>
                                <p>
                                    Age :
                                    <span t-field="o.age"/>
                                </p>
                            </div>
                            <div class="col-6 text-right">
                                <p>
                                    Email :
                                    <span t-field="o.email"/>
                                </p>
                                <p>
                                    Payment Status :
                                    <span t-field="o.payment_status"/>
                                </p>
                            </div>
                        </div>
                            <h3 class='text-center'>Related Records</h3>
                        <table class="table table-condensed">
                            <thead>
                                <tr>
                                    <th><strong>Name</strong></th>
                                    <th><strong>Date</strong></th>
                                    <th><strong>quantity</strong></th>
                                    <th><strong>Price</strong></th>
                                    <th><strong>Total</strong></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.custom_model_related_ids" t-as="line">
                                    <td><t t-esc="line.name"/></td>
                                    <td><t t-esc="line.purchase_date"/></td>
                                    <td><t t-esc="line.quantity"/></td>
                                    <td><t t-esc="line.price"/></td>
                                    <td><t t-esc="line.total"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table table-sm" style="width:40%; float:right;">
                            <tr>
                                <td class="text-right">
                                    <strong>Total Amount</strong>
                                </td>
                                <td class="text-right">
                                    <t t-set="total_amount" t-value="sum(line.total for line in o.custom_model_related_ids)"/>
                                    <span t-esc="total_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
