<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <record id="record_rule_user" model="ir.rule">
            <field name="name">User read-only custom model</field>
            <field name="model_id" ref="model_custom_model"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('custom_module.group_custom_event_user'))]"/>
        </record>

        <record id="record_rule_manager" model="ir.rule">
            <field name="name">Manager full access</field>
            <field name="model_id" ref="model_custom_model"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('custom_module.group_custom_event_manager'))]"/>
        </record>

    </data>
</odoo>