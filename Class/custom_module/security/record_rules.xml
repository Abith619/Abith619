<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <record id="group_rule_user" model="ir.rule">
            <field name="name">User read-only custom model</field>
            <field name="model_id" ref="model_custom_model"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('custom_module.group_custom_event_user'))]"/>
            <field name="perm_unlink" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="False"/>
        </record>

        <record id="group_rule_manager" model="ir.rule">
            <field name="name">Manager full access</field>
            <field name="model_id" ref="model_custom_model"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('custom_module.group_custom_event_manager'))]"/>
            <field name="perm_unlink" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="True"/>
        </record>

    </data>
</odoo>