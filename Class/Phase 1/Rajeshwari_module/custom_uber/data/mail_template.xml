<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Email Template -->
    <record id="email_template_custom_uber" model="mail.template">
        <field name="name">Custom Uber Email</field>
        <field name="model_id" ref="custom_uber.model_custom_uber"/>
        <field name="email_from">${(user.email or 'noreply@example.com')}</field>
        <field name="subject">Hello ${object.name}</field>
        <field name="body_html">
            <![CDATA[
                <p>Hello <strong>${object.name}</strong>,</p>
                <p>Your age is: ${object.age}</p>
                <p>Your email: ${object.email}</p>
                <p>Thank you!</p>
            ]]>
        </field>
    </record>

</odoo>

