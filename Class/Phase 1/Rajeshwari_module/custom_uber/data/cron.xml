<odoo>
    <record id="ir_cron_custom_task" model="ir.cron">
        <field name="name">Custom Uber Cron</field>
        <field name="model_id" ref="model_custom_uber"/>
        <field name="state">code</field>
        <field name="code">model.my_cron_method()</field>
        <field name="interval_number">1</field> <!-- interval value -->
        <field name="interval_type">hours</field> <!-- minutes, hours, days, weeks -->
        <field name="numbercall">-1</field> <!-- -1 = unlimited -->
        <field name="active">True</field>
    </record>
</odoo>

