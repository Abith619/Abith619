<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_custom_form" model="ir.ui.view">
        <field name="name">custom.uber.form</field>
        <field name="model">custom.uber</field>
        <field name="arch" type="xml">
            <form string="Custom Model">

                <header>
                    <button name="%(custom_uber.action_send_message_wizard)d"
                            type="action"
                            string="Send Message"
                            class="btn-primary"/>


                     
                    <button name="action_send_email"
                            type="object"
                            string="Send Email"
                            class="btn-primary"/>
                </header>

                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="age"/>
                        <field name="email"/>
                    </group>
                </sheet>

            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_custom_uber" model="ir.actions.act_window">
        <field name="name">Custom Uber</field>
        <field name="res_model">custom.uber</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_custom_root_1"
              name="Uber Module"
              action="action_custom_uber"
              sequence="2"/>

</odoo>
