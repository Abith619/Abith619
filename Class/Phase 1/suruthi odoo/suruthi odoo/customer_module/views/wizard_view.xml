<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="custom_wizard_view_form" model="ir.ui.view">
        <field name="name">custom.wizard.view.form</field>
        <field name="model">custom.wizard</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">

            <form string="Custom Wizard">
                <group>
                    <field name="name"/>
                </group>

                <group>
                    <field name="description"/>
                </group>

                <footer>
                    <button name="save" string="Save" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
            

        </field>
    </record>

</odoo>
