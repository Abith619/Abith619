<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_form_inherit_custom" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.custom</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <!-- Add Button Before Won Button -->
            <xpath expr="//button[@name='action_set_won_rainbowman']" position="before">
                <button name="action_custom_method"
                        type="object"
                        string="Test"
                        class="btn-primary"/>
            </xpath>

            <!-- Add First Custom Field After Tag_ids -->
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="custom_field"/>
            </xpath>

            <!-- Add Second Custom Field After First Custom Field -->
            <xpath expr="//field[@name='custom_field']" position="after">
                <field name="another_field"/>
            </xpath>

        </field>
    </record>
</odoo>
