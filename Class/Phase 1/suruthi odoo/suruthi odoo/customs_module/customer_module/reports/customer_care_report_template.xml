<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="customer_care_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">Customer Care Report</h2>
                        <br/>
                        <p><strong>Customer Name :</strong> <span t-field="o.customer_name"/></p>
                        <p><strong>Email :</strong> <span t-field="o.email"/></p>
                        <p><strong>Phone :</strong> <span t-field="o.phone"/></p>
                        <p><strong>Status :</strong> <span t-field="o.status"/></p>
                        <p><strong>Priority :</strong> <span t-field="o.priority"/></p>
                        <p><strong>Created Date :</strong> <span t-field="o.created_date"/></p>
                        <hr/>
                        <h3 class="text-center">Related Records</h3>
                        <table style="width:100%; border-collapse: collapse;" border="1">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Date</th>
                                    <th>Qty</th>
                                    <th>Price</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.custom_model_related_ids" t-as="line">
                                    <td><t t-esc="line.name"/></td>
                                    <td><t t-esc="line.purchase_date"/></td>
                                    <td><t t-esc="line.quantity"/></td>
                                    <td><t t-esc="line.price"/></td>
                                    <td><t t-esc="line.total"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <table style="width:35%; float:right; margin-top:10px;" border="1">
                            <tr>
                                <td><strong>Total Amount</strong></td>
                                <td>
                                    <t t-set="total_amount" t-value="sum(line.total for line in o.custom_model_related_ids)"/>
                                    <span t-esc="total_amount"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
