<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="view_student_form" model="ir.ui.view">
        <field name="name">student.demo.form</field>
        <field name="model">student.demo</field>
        <field name="arch" type="xml">
            <form string="Student Form">
                <sheet>
                    <header>
                        <button name="action_show_welcome"
                                type="object"
                                string="Show Welcome Message"
                                class="btn-primary"/>
                    </header>
                    <group>
                        <field name="first_name"/>
                        <field name="last_name"/>
                        <field name="full_name" readonly="1"/>
                        <field name="country"/>
                        <field name="phone_code"/>
                        <field name="age"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_student_tree" model="ir.ui.view">
        <field name="name">student.demo.list</field>
        <field name="model">student.demo</field>
        <field name="arch" type="xml">
            <list>
                <field name="first_name"/>
                <field name="last_name"/>
                <field name="full_name"/>
                <field name="country"/>
                <field name="age"/>
            </list>
        </field>
    </record>

    <record id="action_student_demo" model="ir.actions.act_window">
        <field name="name">Student Demos</field>
        <field name="res_model">student.demo</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_student_demo_root" name="Student Menu"/>
    <menuitem id="menu_student_demo" name="Students"
              parent="menu_student_demo_root" action="action_student_demo"/>
</odoo>
