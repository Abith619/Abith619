<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Main Menu -->
    <menuitem id="menu_api_app_root" name="API Learning App"/>

    <!-- LIST VIEW -->
    <record id="view_api_demo_list" model="ir.ui.view">
        <field name="name">api.demo.list</field>
        <field name="model">api.demo</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="age"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_api_demo_form" model="ir.ui.view">
        <field name="name">api.demo.form</field>
        <field name="model">api.demo</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="age"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_api_demo" model="ir.actions.act_window">
        <field name="name">API Demo</field>
        <field name="res_model">api.demo</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENU ITEM -->
    <menuitem id="menu_api_demo_items"
              parent="menu_api_app_root"
              action="action_api_demo"/>
</odoo>
