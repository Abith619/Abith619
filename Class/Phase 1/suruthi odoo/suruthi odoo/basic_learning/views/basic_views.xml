<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_basic_learning" model="ir.actions.act_window">
        <field name="name">Business Board</field>
        <field name="res_model">basic.business</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_business_root" name="Business App" action="action_basic_learning"/>

    <record id="view_business_list" model="ir.ui.view">
        <field name="name">business.list</field>
        <field name="model">basic.business</field>
        <field name="arch" type="xml">
            <list>
                <field name="partnername"/>
                <field name="phonenumber"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <record id="view_business_form" model="ir.ui.view">
        <field name="name">business.form</field>
        <field name="model">basic.business</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="partnername"/>
                        <field name="email"/>
                        <field name="phonenumber"/>
                    </group>

                    <footer>
                     <button name="action_print_report"
                             type="object"
                            string="Print Report"
                            class="btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
