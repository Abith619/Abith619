<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="custom_wizard_view_form" model="ir.ui.view">
        <field name="name">custom.wizard.view.form</field>
        <field name="model">custom.wizard</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
           <form string="Custom Wizard">
               <group>
                   <field name="name"/>
                 <field name="payment"/>
               </group>
               <group>
                   <field name="description"/>
                   <field name="custom_model_id" invisible="1"/>
               </group>
              
               <footer>
                    <button name="action_save" type="object" string="Save" class="btn-primary"/>
                   <button name="cancel" string="Cancel" special="cancel"/>
               </footer>
           </form>
       </field>
   </record>
</odoo>