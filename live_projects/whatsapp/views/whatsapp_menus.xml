        parent="whatsapp_main_menu"
        sequence="1"
        action="whatsapp.whatsapp_message_action"
        />

    <menuitem name="Configuration"
        id="whatsapp_configuration_menu"
        parent="whatsapp_main_menu"
        />

    <menuitem id="menu_whatsapp_incoming_message"
