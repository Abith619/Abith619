<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="mrp_production_view_form_inherit_custom" model="ir.ui.view">
        <field name="name">mrp.production.inherit.custom</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_raw_ids']//field[@name='product_uom_qty']" position="after">
                <field name="area"/>
                <field name="measure"/>
            </xpath>
        </field>
    </record>
</odoo>