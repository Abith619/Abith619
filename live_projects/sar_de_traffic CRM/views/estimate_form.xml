            </form>
        </field>
    </record>
    <record id="view_estimate_list" model="ir.ui.view">
        <field name="name">quotation.estimate.list</field>
        <field name="model">quotation.estimate</field>
        <field name="arch" type="xml">
            <list string="Estimates" default_order="date_from desc, id desc">
                <field name="name"/>
                <field name="date_from"/>
                <field name="customer_id" avatar_field="avatar_128" options="{'icon': 'fa fa-users'}"/>
                <field name="project_id"/>
                <field name="taxes_id"/>
                <field name="currency_id" optional='hide'/>
                <field name="amount_total" widget="monetary" class="fw-bold text-info" sum="Total Amount"/>
                <field name="status" widget="badge"
                    decoration-info="status == 'draft'"
                    decoration-success="status in ('done', 'confirmed')"
                    decoration-danger="status == 'cancelled'"
                />
            </list>
        </field>
    </record>
    <record id="action_estimate" model="ir.actions.act_window">
        <field name="name">Estimates</field>
        <field name="res_model">quotation.estimate</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_estimate_update" model="ir.actions.server">
        <field name="name">Create Quotation</field>
        <field name="model_id" ref="model_quotation_estimate"/>
        <field name="binding_model_id" ref="model_quotation_estimate"/>
        <field name="state">code</field>
        <field name="code">model.action_create_quotation()</field>
    </record>

    <menuitem id="menu_estimate"
        name="Estimates"
        sequence="2"
        action="sar_de_traffic.action_estimate"
        parent="sale.sale_order_menu"
        active="True"
    />

    <menuitem id="menu_estimates"
        name="Estimates"
        sequence="1"
        action="sar_de_traffic.action_estimate"
        parent="crm.crm_menu_sales"
        active="True"
    />

</odoo>