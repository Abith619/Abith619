<odoo>
    <record id="view_estimate_form_line" model="ir.ui.view">
        <field name="name">quotation.estimate.form</field>
        <field name="model">quotation.estimate</field>
        <field name="arch" type="xml">
            <form string="Estimate">
            <style>
                .total_bold_text {
                    font-weight: bolder !important;
                }
            </style>
                <header>
                    <button name='action_confirm' type='object' string='Confirm' class='btn-primary' invisible="status in 'confirmed'"/>
                    <button name='action_cancel' type='object' string='Cancel' class='btn-primary' invisible="status in 'cancelled'"/>
                    <field name='status' widget='statusbar' statusbar_visible='draft,confirmed,cancelled'/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name='item_product'/>
                            <field name='item_category'/>
                            <field name='estimate_qty'/>
                            <field name='amount_total' readonly="1"/>
                        </group>
                        <group>
                            <field name='name'/>
                            <field name='customer_id'/>
                            <field name="date_from"/>
                            <field name="rate_per_quantity"/>
                        </group>
                    </group>
                    <field name="lead_id" invisible="1"/>
                    <notebook>
                        <page string='Sign'>
                            <field name='stage_one_sign'>
                                <list editable='bottom'>
                                    <field name='resource_type'/>
                                    <field name="acc_group"/>
                                    <field name="resource_for"/>
                                    <field name="resource_name"/>
                                    <field name="make_id"/>
                                    <field name="supplier_id"/>
                                    <field name="unit_id"/>
                                    <field name="co_efficient"/>
                                    <field name="rate_factor"/>
                                    <field name="calc_qty"/>
                                    <field name="unit_rate"/>
                                    <field name="delivery_charges"/>
                                    <field name="wastage"/>
                                    <field name="wastage_amount"/>
                                    <field name="resources_total"/>
                                    <field name="add_rate"/>
                                    <field name="net_amount"/>
                                </list>
                            </field>
                            <group col="2">
                                <group class="oe_subtotal_footer oe_left" colspan="2" style="width: 30%;">
                                    <div style="text-align:center; vertical-align:middle; font-size:16px; font-weight:bold; margin:5px 0;">
                                        Corporate Summary
                                    </div>
                                    <field name="net_amount"/>
                                    <field name="corporate_oh"/>
                                    <field name="corporate_oh_rate"/>
                                    <field name="corporate_profit"/>
                                    <field name="corporate_profit_rate"/>
                                    <div class="oe_subtotal_footer_separator oe_inline o_td_label"/>
                                    <field name='amount_total' readonly="1" class="total_bold_text"/>
                                </group>
                                <group class="oe_subtotal_footer oe_right" colspan="2" style="width: 30%;">
                                    <div style="text-align:center; vertical-align:middle; font-size:16px; font-weight:bold; margin:5px 0;">
                                        Net Summary
                                    </div>
                                    <field name="sign_sub_total" readonly="1"/>
                                    <field name="sign_over_head_expense" />
                                    <field name="sign_expense_rate" readonly="1"/>
                                    <field name="sign_profit" />
                                    <field name="sign_profit_rate" readonly="1"/>
                                    <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                        <label class="total_bold_text" for="sign_grand_total" />
                                    </div>
                                    <field name="sign_grand_total" nolabel="1" class="oe_subtotal_footer_separator" readonly="1"/>
                                </group>
                            </group>
                        </page>
