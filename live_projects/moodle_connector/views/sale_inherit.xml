<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_order_form_inherit_moodle" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.moodle</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Add token just below origin -->
            <xpath expr="//field[@name='origin']" position="after">
                <field name="moodle_token"/>
                <field name="payment_proof" filename="payment_proof_filename"/>
                <field name="payment_proof_filename" invisible="1"/>
            </xpath>

        </field>
    </record>
</odoo>
