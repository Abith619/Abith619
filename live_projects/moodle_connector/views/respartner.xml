<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_res_partner_form_inherits" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.website_lead_form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='o_address_format']" position="after">
            <form class="form-inline">
                    <div class="form-group row ">
                        <label for="dob" class="col-sm-2 col-form-label">DOB</label>
                        <div class="col-sm-10">
                            <field name="dob" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="gender" class="col-sm-2 col-form-label">Gender</label>
                        <div class="col-sm-10">
                            <field name="gender" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="institution_name" class="col-sm-2 col-form-label">Institution</label>
                        <div class="col-sm-10">
                            <field name="institution_name" />
                        </div>

                    </div>
                    <div class="form-group row">
                        <label for="institution_address" class="col-sm-2 col-form-label">Address</label>
                        <div class="col-sm-10">
                            <field name="institution_address" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="qualification" class="col-sm-2 col-form-label">Qualification</label>
                        <div class="col-sm-10">
                            <field name="qualification" />
                        </div>
                    </div>
            </form>

            </xpath>
        </field>
    </record>
</odoo>