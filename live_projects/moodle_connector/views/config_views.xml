<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_moodle_config_form" model="ir.ui.view">
        <field name="name">moodle.config.form</field>
        <field name="model">moodle.config</field>
        <field name="arch" type="xml">
            <form string="Moodle Configuration">
                <style>

                </style>
                <header>
                    <button name='test_moodle' type='object' string='Test' class='btn-primary'/>
                    <button name='fetch_contents' type='object' string='Import' class='btn-primary'/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="url"/>
                            <field name="token"/>
                        </group>
                        <group>
                            <field name="category"/>
                            <field name="course"/>
                            <field name="user"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_moodle_config" model="ir.actions.act_window">
        <field name="name">Moodle Configuration</field>
        <field name="res_model">moodle.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_moodle_config"
        name="Moodle Config"
        sequence="1"
        action="action_moodle_config"
        parent="website_slides.website_slides_menu_configuration"
        active="True"
    />

</odoo>
