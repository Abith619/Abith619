<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_slide_channel_partner_list_inherit" model="ir.ui.view">
        <field name="name">slide.channel.partner.list.inherit</field>
        <field name="model">slide.channel.partner</field>
        <field name="inherit_id" ref="website_slides.slide_channel_partner_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='channel_website_id']" position="after">
                <field name="total_lesson_marks"/>
                <field name="total_assignment_marks"/>
                <field name="total_quiz_xp"/>
                <field name="user_total_marks"/>
                <field name="overall_percentage"/>
                <field name="grade_id"/>
            </xpath>
        </field>
    </record>
    <record id="view_student_grade_graph" model="ir.ui.view">
        <field name="name">student.grade.graph</field>
        <field name="model">slide.channel.partner</field>
        <field name="arch" type="xml">
            <graph string="Grade Distribution" type="pie">
                <field name="grade_id"/>
                <field name="id" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_student_course_pivot" model="ir.ui.view">
        <field name="name">student.course.pivot</field>
        <field name="model">slide.channel.partner</field>
        <field name="arch" type="xml">
            <pivot string="Student Analytics">
                <field name="channel_id" type="row"/>
                <field name="grade_id" type="col"/>
                <field name="id" type="measure"/>
            </pivot>
        </field>
    </record>




    <record id="view_slide_channel_partner_form" model="ir.ui.view">
        <field name="name">slide.channel.partner.form</field>
        <field name="model">slide.channel.partner</field>
        <field name="arch" type="xml">
            <form string="Course Participant">
                <header>
                    <button
                        name="%(moodle_connector.action_student_grade_report)d"
                        string="Print Grade Report"
                        type="action"
                        class="btn-primary"
                        invisible="member_status != 'completed'"/>
                </header>

                <sheet>

                    <!-- ================= BASIC INFORMATION ================= -->
                    <group col="2">
                        <group>
                            <field name="channel_id" string="Course Name"/>
                            <field name="partner_id"/>
                            <field name="partner_email" string="Email"/>

                            <field name="member_status"
                                    widget="badge"
                                    decoration-success="member_status == 'completed'"
                                    decoration-info="member_status == 'ongoing'"
                                    decoration-warning="member_status == 'joined'"
                                    decoration-muted="member_status == 'invited'"/>

                            <field name="completion" widget="progressbar"/>
                            <field name="survey_certification_success"/>
                            
                        </group>

                        <group>
                            <field name="create_date"/>
                            <field name="write_date"/>
                            <field name="last_invitation_date" optional="hide"/>
                            <field name="next_slide_id"/>
                            <field name="channel_user_id"
                                    widget="many2one_avatar_user"
                                    optional="hide"/>
                            <field name="show_results_on_website"/>
                        </group>
                    </group>

                    <separator string="Enrollment Details"/>

                    <!-- NOTEBOOK -->
                    <notebook>

                        <!-- LESSONS -->
                        <page string="Lessons">
                            <field name="lesson_line_ids" nolabel="1">
                                <list>
                                    <field name="section_id"/>
                                    <field name="slide_id"/>
                                    <field name="is_lesson_custom_marks"/>
                                    <field name="lesson_custom_marks" invisible="not is_lesson_custom_marks"/>
                                    <field name="lesson_marks"/>
                                </list>
                            </field>
                        </page>

                        <!-- ASSIGNMENTS -->
                        <page string="Assignments">
                            <field name="assignment_line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="section_id"/>
                                    <field name="slide_id"/>
                                    <field name="assignment_attachment_ids"                                            
                                            widget="many2many_binary"/>
                                    <field name="assignment_marks"/>
                                    <field name="assignment_total_marks"/>
                                </list>
                            </field>
                        </page>

                        <!-- QUIZZES -->
                        <page string="Quizzes">
                            <field name="quiz_line_ids" nolabel="1">
                                <list>
                                    <field name="section_id"/>
                                    <field name="slide_id"/>
                                    <field name="quiz_attempts_count"/>
                                    <field name="quiz_xp"/>
                                    <field name="quiz_out_of_marks"/>
                                </list>
                            </field>
                        </page>

                    </notebook>
                    <separator string="Overall Result"/>
                    <group col="2">
                        <group>
                            <group>
                                <field name="total_lesson_marks" string="User Lesson Marks" readonly="1"/>
                                <field name="total_assignment_marks" string="User Assignment Marks " readonly="1"/>
                                <field name="total_assignment_out_of" string="Total Assignment Marks " readonly="1"/>
                                <field name="total_quiz_xp" string="User Quiz Marks" readonly="1"/>
                                <field name="total_quiz_out_of" string="Total Quiz Marks" readonly="1"/>
                            </group>
                            <group>
                                <field name="user_total_marks" readonly="1"/>
                                <field name="overall_total_marks" readonly="1"/>
                                <field name="overall_percentage" string="User Percentage" readonly="1"/>
                            </group>
                        </group>
                            <group>
                                <field name="grade_id" string="User Grade" />
                            </group>
                    
                    
                    </group>


                

                </sheet>
            </form>
        </field>
    </record>


</odoo>
