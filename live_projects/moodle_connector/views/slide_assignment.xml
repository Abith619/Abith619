<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_slide_channel_partner_form" model="ir.ui.view">
        <field name="name">slide.channel.partner.form</field>
        <field name="model">slide.channel.partner</field>
        <field name="arch" type="xml">
            <form string="Course Participant">
                <sheet>

                    <!-- BASIC INFO -->
                    <group col="2">
                        <group>
                            <field name="channel_id"/>
                            <field name="partner_id"/>
                            <field name="partner_email"/>
                            <field name="member_status" widget="badge"/>
                            <field name="completion" widget="progressbar"/>
                            <field name="survey_certification_success"/>
                        </group>

                        <group>
                            <field name="create_date"/>
                            <field name="write_date"/>
                        </group>
                    </group>

                    <!-- LESSON DETAILS -->
                    <notebook>
                        <page string="Lessons and Points">
                            <field name="lesson_progress_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="section_id"/>
                                    <field name="slide_id"/>
                                    <field name="assignment_attachment_ids"
                                        widget="many2many_binary"/>
                                    <field name="assignment_marks"/>
                                    <field name="quiz_attempts_count"/>
                                    <field name="quiz_xp"/>
                                    <field name="quiz_out_of_marks"/>
                                    <field name="completed"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                    <!-- OVERALL RESULT -->
                    <separator string="Overall Result"/>

                    <group col="2">
                        <group/>
                        <group>
                            <field name="total_quiz_xp" readonly="1"/>
                            <field name="total_quiz_out_of" readonly="1"/>
                            <field name="total_assignment_marks" readonly="1"/>
                            <field name="user_total_marks" readonly="1"/>
                            <field name="quiz_percentage"
                                   widget="percentage"
                                   readonly="1"/>
                            <field name="quiz_grade"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

</odoo>
