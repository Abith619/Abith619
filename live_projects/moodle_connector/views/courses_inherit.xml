<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="inherit_course_join" inherit_id="website_slides.course_join" name="Inherit Course Join Template" >
        <xpath expr="//div[contains(@class, 'o_wslides_js_course_join')]" position="inside">
            <style>
                .o_wslides_js_course_join_link{
                    display: none !important;
                }
                .btn-purple {
                    background: linear-gradient(135deg, #46006d, #7a00c2);
                    color: #fff;
                    border: none;
                    border-radius: 8px;
                    padding: 10px 20px;
                    transition: all 0.4s ease;
                    box-shadow: 0 4px 10px rgba(70, 0, 109, 0.3);
                }
                .btn-purple:hover {
                    background: linear-gradient(135deg, #7a00c2, #a200ff);
                    transform: translateY(-3px) scale(1.03);
                    box-shadow: 0 8px 20px rgba(122, 0, 194, 0.5);
                    color: #fff;
                }
            </style>
            <t t-if="channel.application_product_id">
                <div class="text-center mt-2">
                    <form action="/shop/cart/update" method="post" class="d-inline">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="product_id" t-att-value="channel.application_product_id.id"/>
                        <input type="hidden" name="custom_course_id" t-att-value="channel.id"/>
                        <input type="hidden" name="add_qty" value="1"/>
                        <button type="submit" class="btn btn-purple d-block">
                            <i class="fa fa-bolt"></i>
                            Register (Pay Application Fee)
                        </button>
                    </form>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
