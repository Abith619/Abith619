<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_crm_lead_form_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_set_won_rainbowman']" position="before">
                <button name="action_approve_lead" type="object" string="Approve &amp; Send" class="btn-primary"/>
            </xpath>

            <!-- <xpath expr="//button[@name='action_set_won_rainbowman']" position="before">
                <button name="action_checkout" type="object" string="Checkout" class="btn-primary"/>
            </xpath> -->


            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="course_id"/>
            </xpath>
            <xpath expr="//field[@name='user_company_ids']" position="after">
                <field name="payment_link"/>
                <field name="payment_status" widget="radio"/>
                <field name="unique_token" invisible="1"/>
                <field name="paypal_order_id" invisible="1"/>
                <field name="paypal_temp_token" invisible="1"/>
            </xpath>
            <xpath expr="//notebook/page[@name='internal_notes']" position="after">
                <page string="Documents">
                    <group string="Images (Binary)">
                        <group>
                            <field name="photo" widget="image" style="width:100px; height:100px;"/>
                        </group>
                        <group>
                            <field name="certificates" widget="image" style="width:100px; height:100px;"/>
                        </group>
                        <group>
                            <field name="government_id" widget="image" style="width:100px; height:100px;"/>
                        </group>
                        <group>
                            <field name="electronic_signature" widget="image" style="width:100px; height:100px;"/>
                        </group>
                    </group>

                    <group string="Attachments (PDF)">
                        <group>
                            <field name="academic_transcript" widget="many2many_binary"/>
                            <field name="recommendation_letter" widget="many2many_binary"/>
                            <field name="personal_statement" widget="many2many_binary"/>
                        </group>
                        <group>
                            <field name="proof_upload" widget="many2many_binary"/>
                            <field name="transcript_upload" widget="many2many_binary"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>