<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_about_page" name="About Us" inherit_id="website.aboutus">
        <xpath expr="//div[@id='wrap']" position="replace">
            <style>
                :root {
                    --deep-purple: #2a0b34;
                    --gold: #C2922E;
                    --soft-bg: #f9f7fa;
                    --muted-white: rgba(255,255,255,0.85);
                }

                /* HERO */
                .about-hero {
                    position: relative;
                    background: linear-gradient(180deg, rgba(42,11,52,0.86) 0%, rgba(42,11,52,0.86) 100%);
                    padding: 80px 0;
                    overflow: visible;
                }
                .about-hero .hero-overlay {
                    position: absolute;
                    inset: 0;
                    background: linear-gradient(180deg, rgba(42,11,52,0.55), rgba(42,11,52,0.6));
                    z-index: 1;
                }
                .about-hero .container { position: relative; z-index: 2; }
                .about-hero .hero-img { max-width: 360px; transform: translateY(-10px); }

                /* decorative vector */
                .about-vector {
                    position: absolute;
                    left: -20px;
                    bottom: -10px;
                    width: 220px;
                    opacity: 0.18;
                    z-index: 0;
                    pointer-events: none;
                }

                /* Mission / Vision / Values cards */
                .section-mvpy { padding: 60px 0; }
                .mv-card {
                    border: none;
                    border-radius: 12px;
                    background: #fff;
                    text-align: left;
                    box-shadow: 0 8px 24px rgba(10,10,10,0.06);
                }
                .mv-icon {
                    font-size: 28px;
                    color: var(--gold);
                }

                /* History (dark section) */
                .bg-deep {
                    background: linear-gradient(180deg, var(--deep-purple) 0%, #2a0b34 100%);
                    color: #fff;
                }
                .timeline { margin-top: 20px; }
                .timeline-item { display:flex; gap:12px; margin-bottom:12px; align-items:flex-start; }
                .timeline-year {
                    background: rgba(255,255,255,0.08);
                    padding:8px 12px;
                    border-radius:6px;
                    font-weight:700;
                    min-width:72px;
                    text-align:center;
                }

                /* Team */
                .section-team { padding: 60px 0; }
                .team-card {
                    background: #fff;
                    border-radius: 12px;
                    box-shadow: 0 8px 18px rgba(0,0,0,0.06);
                }
                .team-avatar { width:96px; height:96px; object-fit:cover; }

                /* Programs */
                .section-programs { padding: 60px 0; }
                .program-card { background: #fff; border-radius:10px; box-shadow:0 6px 16px rgba(0,0,0,0.05); }

                /* CTA */
                .section-cta { padding: 60px 0; text-align:center; }
                .btn-cta-outline {
                    border: 2px solid #fff;
                    color: #fff;
                    background: transparent;
                    padding: 10px 20px;
                    border-radius: 8px;
                }
                .btn-cta-outline:hover { background: rgba(255,255,255,0.06); }

                /* Newsletter */
                .section-newsletter { padding: 40px 0; }

                /* utility buttons */
                .btn-primary { background: var(--gold); border-color: var(--gold); color: #000; font-weight:700; }
                .btn-primary:hover { background: #a77d22; border-color:#a77d22; color:#fff; }
                .btn-gold { background: var(--gold); color:#000; border:none; padding:8px 18px; border-radius:8px; font-weight:700; }

                /* Responsive tweaks */
                @media (max-width: 992px) {
                    .about-vector { width: 160px; left: -8px; opacity: 0.14; }
                    .about-hero { padding: 50px 0; }
                    .hero-img { max-width: 220px; }
                }
                </style>
            <div id="wrap">

                <!-- HERO -->
                <section class="about-hero position-relative">
                    <div class="hero-overlay"></div>
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-lg-7">
                                <h1 class="display-4 text-white mb-3">About Landmark Christian University</h1>
                                <p class="lead text-white-75 mb-4">
                                    Equipping leaders for ministry and life through biblically-rooted, academically excellent online programs.
                                </p>
                                <p>
                                    <a href="/slides" class="btn btn-primary btn-cta me-2">Our Programs</a>
                                    <a href="/contactus" class="btn btn-outline-light">Contact Admissions</a>
                                </p>
                            </div>
                            <div class="col-lg-5 d-none d-md-block text-end">
                                <img src="/moodle_connector/static/src/img/home_cover.jpg"
                                     alt="Students" class="img-fluid hero-img" loading="lazy"/>
                            </div>
                        </div>
                    </div>

                    <!-- decorative vector bottom-left -->
                    <img src="/moodle_connector/static/src/img/Vector.png" class="about-vector" alt="Vector" loading="lazy"/>
                </section>

                <!-- MISSION / VISION / VALUES -->
                <section class="section-mvpy py-5">
                    <div class="container">
                        <div class="row text-center g-4">
                            <div class="col-lg-4">
                                <div class="card mv-card h-100 p-4">
                                    <div class="mv-icon mb-3"><i class="bi bi-geo-alt-fill"></i></div>
                                    <h5 class="fw-bold">Our Mission</h5>
                                    <p class="mb-0">To develop Christ-centered leaders by providing accessible, relevant, and accredited Christian education online.</p>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="card mv-card h-100 p-4">
                                    <div class="mv-icon mb-3"><i class="bi bi-eye-fill"></i></div>
                                    <h5 class="fw-bold">Our Vision</h5>
                                    <p class="mb-0">A global community equipped to transform churches, workplaces and nations with the gospel and godly leadership.</p>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="card mv-card h-100 p-4">
                                    <div class="mv-icon mb-3"><i class="bi bi-heart-fill"></i></div>
                                    <h5 class="fw-bold">Core Values</h5>
                                    <p class="mb-0">Excellence, Scripture-centered teaching, service, accessibility, and community.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- TIMELINE / HISTORY -->
                <section class="section-history py-5 bg-deep">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-lg-6">
                                <h2 class="text-white">Our Story</h2>
                                <p class="text-white-75">
                                    Since our founding, Landmark Christian University has pursued biblically faithful education with practical ministry training.
                                </p>

                                <div class="timeline">
                                    <div class="timeline-item">
                                        <div class="timeline-year">2005</div>
                                        <div class="timeline-body">Founded by a group of ministry leaders to provide accessible Christian higher education.</div>
                                    </div>
                                    <div class="timeline-item">
                                        <div class="timeline-year">2015</div>
                                        <div class="timeline-body">Expanded to online delivery to serve international and working students.</div>
                                    </div>
                                    <div class="timeline-item">
                                        <div class="timeline-year">2022</div>
                                        <div class="timeline-body">Full accreditation received for undergraduate and graduate programs.</div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <img src="/moodle_connector/static/src/img/student_1.png" alt="History" class="img-fluid rounded shadow-sm" loading="lazy"/>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- TEAM -->
                <section class="section-team py-5">
                    <div class="container text-center">
                        <h2>Meet Our Spiritual Guides</h2>
                        <p class="lead mb-4 text-muted">Dedicated faculty and mentors who walk with you.</p>
                        <div class="row g-4 justify-content-center">
                            <t t-foreach="[1,2,3,4]" t-as="i">
                                <div class="col-md-3">
                                    <div class="team-card p-3 h-100 text-start">
                                        <img src="/web/image/website.s_company_team_image_1" class="rounded-circle mb-3 team-avatar" alt="Member" loading="lazy"/>
                                        <h5 class="mb-0">Name <small class="text-muted d-block">Title</small></h5>
                                        <p class="small text-muted mt-2">Short bio that describes the person's role and passion for students.</p>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </section>

                <!-- PROGRAMS HIGHLIGHT -->
                <section class="section-programs py-5 bg-soft">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-lg-6">
                                <h2>Programs Designed for Impact</h2>
                                <p class="text-muted">Flexible, accredited programs that equip you for ministry and leadership.</p>
                                <a href="/slides" class="btn btn-primary btn-cta">View Programs</a>
                            </div>
                            <div class="col-lg-6">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="program-card p-3 h-100">
                                            <img src="/moodle_connector/static/src/img/student_2.jpg" class="img-fluid rounded mb-2" alt="Program"/>
                                            <h6 class="mb-0">Bachelor of Ministry</h6>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="program-card p-3 h-100">
                                            <img src="/moodle_connector/static/src/img/church.png" class="img-fluid rounded mb-2" alt="Program"/>
                                            <h6 class="mb-0">Graduate Leadership Certificate</h6>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- CTA -->
                <section class="section-cta py-5">
                    <div class="container text-center">
                        <h3 class="mb-3">Ready to Start Your Spiritual Journey?</h3>
                        <p class="text-muted mb-4">Apply now or speak with an admissions advisor to find the right program for you.</p>
                        <a href="/web/signup" class="btn btn-cta-outline me-2">Apply Now</a>
                        <a href="/contactus" class="btn btn-primary">Contact Admissions</a>
                    </div>
                </section>
            </div>
        </xpath>
    </template>
</odoo>