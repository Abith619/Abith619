<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_order_form_inherit_lead" model="ir.ui.view">
        <field name="name">sale.order.form.lead.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Add field under Customer -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="lead_id" options="{'no_open': True}"/>
            </xpath>

        </field>
    </record>
</odoo>