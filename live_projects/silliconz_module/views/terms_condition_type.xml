    <!-- ================= PURCHASE ACTION ================= -->
    <record id="action_terms_and_condition_purchase" model="ir.actions.act_window">
        <field name="name">Terms and Conditions</field>
        <field name="res_model">terms.and.condition</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('type','=','purchase')]</field>
        <field name="context">{'default_type':'purchase'}</field>
    </record>

    <menuitem id="menu_terms_and_condition_purchase"
                name="Terms and Conditions"
                parent="purchase.menu_purchase_config"
                action="action_terms_and_condition_purchase"
                sequence="30"/>

    <record id="action_terms_and_condition_quotation" model="ir.actions.act_window">
        <field name="name">Terms and Conditions</field>
        <field name="res_model">terms.and.condition</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('type','=','quotation')]</field>
        <field name="context">{'default_type':'quotation'}</field>
    </record>
    
    <menuitem id="menu_terms_and_condition_quotation"
                name="Terms and Conditions"
                parent="sale.menu_sale_config"
                action="action_terms_and_condition_quotation"
                sequence="40"/>

    <record id="action_terms_and_condition_general" model="ir.actions.act_window">
        <field name="name">Terms and Conditions</field>
        <field name="res_model">terms.and.condition</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('type','=','invoice')]</field>
        <field name="context">{'default_type':'invoice'}</field>
    </record>

    <menuitem id="menu_terms_and_condition_general"
                name="Terms and Conditions"
                parent="account.menu_finance_configuration"
                action="action_terms_and_condition_general"
                sequence="30"/>


    <record id ="action_terms_and_condition_delivery" model="ir.actions.act_window">
        <field name="name">Terms and Conditions</field>
        <field name="res_model">terms.and.condition</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('type','=','delivery')]</field>
        <field name="context">{'default_type':'delivery'}</field>
    </record>

    <menuitem id="menu_terms_and_condition_delivery"
                name="Terms and Conditions"
                parent="stock.menu_stock_config_settings"
                action="action_terms_and_condition_delivery"
                sequence="30"/>

