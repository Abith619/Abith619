<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================= FORM VIEW ================= -->
    <record id="view_terms_and_condition_form" model="ir.ui.view">
        <field name="name">terms.and.condition.form</field>
        <field name="model">terms.and.condition</field>
        <field name="arch" type="xml">
            <form string="Terms and Condition">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Terms Title" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Standard Sale Terms"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="type"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Conditions Description">
                            <field name="content" placeholder="Enter terms and conditions content here..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <!-- ================= LIST VIEW (Odoo 19) ================= -->
    <record id="view_terms_and_condition_list" model="ir.ui.view">
        <field name="name">terms.and.condition.list</field>
        <field name="model">terms.and.condition</field>
        <field name="arch" type="xml">
            <list string="Terms and Conditions">
                <field name="name"/>
                <field name="type"/>
                <field name="active"/>
            </list>
        </field>
    </record>


