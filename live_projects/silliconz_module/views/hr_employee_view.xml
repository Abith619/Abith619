<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_silliconz" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.silliconz</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='personal_information']/group" position="inside">
                <group string="Statutory Information" name="hr_statutory_group">
                    <field name="aadhaar_number" required="1"/>
                    <field name="pan_number" required="1"/>
                    <field name="pf_number" required="1"/>
                    <field name="esic_number" required="1"/>
                    <field name="esi_insurance_number"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
