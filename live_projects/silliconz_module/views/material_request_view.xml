<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================= -->
    <!-- Material Request Form View -->
    <!-- ================================= -->
    <record id="material_request_form" model="ir.ui.view">
        <field name="name">material.request.form</field>
        <field name="model">material.request</field>
        <field name="arch" type="xml">
            <form edit="true">


                <!-- ===== HEADER ===== -->
                <header>
                    <!-- Submit : User -->
                    <button name="action_submit"
                            type="object"
                            string="Submit"
                            invisible="state != 'draft'"
                            groups="silliconz_module.group_material_request_user, silliconz_module.group_material_request_approver"/>

                    <!-- Approve : Approver -->
                    <button name="action_approve"
                            type="object"
                            string="Approve"
                            invisible="state != 'submitted'"
                            groups="silliconz_module.group_material_request_approver"/>
                    <!-- Reject : Approver -->
                    <button name="action_reject"
                            type="object"
                            string="Reject"
                            invisible="state != 'submitted'"
                            groups="silliconz_module.group_material_request_approver"/>

                    <!-- Reset to Draft : Approver (after rejection) -->
                    <button name="action_reset_to_draft"
                            type="object"
                            string="Reset to Draft"
                            invisible="state != 'rejected'"
                            groups="silliconz_module.group_material_request_user, silliconz_module.group_material_request_approver"/>

                    <!-- Create Transfer : Approver -->
                    <button name="action_create_transfer"
                            type="object"
                            string="Create Transfer"
                            invisible="state != 'approved'"
                            groups="silliconz_module.group_material_request_approver"/>

                    <field name="state" widget="statusbar"/>
                    <button name="action_create_purchase_request"
                            type="object"
                            string="Create Purchase Request"
                            class="btn-secondary"
                            groups="silliconz_module.group_material_request_approver"
                            invisible="state != 'approved'"/>
                </header>

                <!-- ===== BODY ===== -->
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_transfers"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-truck"
                            groups="silliconz_module.group_material_request_approver,silliconz_module.group_material_request_user">
                            <field name="transfer_count" widget="statinfo" string="Transfers"/>
                        </button>
                        <button
                            name="action_view_purchase_requests"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-shopping-cart"
                            groups="silliconz_module.group_material_request_approver">
                            <field name="purchase_request_count" widget="statinfo" string="Purchase Requests"/>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" nolabel="1"/>
                        </h1>
                    </div>

                    <!-- Basic Details -->
                    <group>
                        <group>
                            <field name="requester_id" readonly="1"/>
                            <field name="request_date"/>
                            <field name="expected_date"/>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="mo_id" readonly="1"/>
                            <field name="product_id" readonly="1" invisible="1"/> 
                        </group>

                        <group>
                            <field name="source_location_id"/>
                            <field name="destination_location_id"/>
                            <field name="analytic_account_id" string="Project Code Name" options="{'no_create': True}"/>
                            <field name="priority" widget="priority"/>
                        </group>
                    </group>

                    <!-- Remarks -->
                    <group>
                        <field name="remarks" placeholder="Enter any remarks or notes..." nolabel="1" colspan="2"/>
                    </group>

                    <!-- Material Request Lines -->
                    <field name="line_ids"
                            context="{'default_destination_location_id': destination_location_id}">
                        <list editable="top">
                            
                            <field name="product_id"/>
                            <field name="description"/>
                            <field name="requested_qty"/>
                            <field name="uom_id"/>
                            <field name="manufacturer_ids" string="Manufacturers"
                                            domain="[('id', 'in', allowed_manufacturer_ids)]"
                                            options="{'no_open': True, 'no_create_edit': True}"
                                            />
                            <field name="manufacturer_part_number_ids" string="Part Numbers"
                                            domain="[('id', 'in', allowed_part_number_ids)]"
                                            context="{'default_product_tmpl_id': product_tmpl_id, 'default_manufacturer_id': manufacturer_ids}"
                                            options="{'no_open': True, 'no_create_edit': True}"
                            />

                            <field name="product_tmpl_id" optional="hide"/>
                                        
                            <field name="can_edit_approved_qty" column_invisible="1"/>
                            <field name="approved_qty" readonly="not can_edit_approved_qty"/>
                            <field name="available_qty" readonly="1" groups= "silliconz_module.group_material_request_approver" />
                            <field name="issued_qty" readonly="1"/>
                            <field name="issued_date" readonly="1"/>
                            <field name="destination_location_id"/>
                            <field name="line_remarks"/>
                        </list>
                    </field>
                </sheet>

            </form>
        </field>
    </record>
    <!-- ================================= -->
    <!-- Material Request List View -->
    <!-- ================================= -->
    <record id="material_request_tree" model="ir.ui.view">
        <field name="name">material.request.tree</field>
        <field name="model">material.request</field>
        <field name="arch" type="xml">
            <list> 
                <field name="name" readonly="1"/>
                <field name="requester_id"/>        
                <field name="request_date"/>
                <field name="expected_date"/>
                <field name="priority" widget="priority"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- ================================= -->
    <!-- Action -->
    <!-- ================================= -->
    <record id="action_material_request" model="ir.actions.act_window">
        <field name="name">Material Requests</field>
        <field name="res_model">material.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ================================= -->
    <!-- Menus -->
    <!-- ================================= -->

    <!-- Root Menu -->
    <menuitem id="menu_material_request_root"
                name="Material Request"
                sequence="10"
                groups="silliconz_module.group_material_request_user,silliconz_module.group_material_request_approver"/>

    <!-- Sub Menu -->
    <menuitem id="menu_material_request"
                name="Requests"
                parent="menu_material_request_root"
                action="action_material_request"
                sequence="10"
                groups="silliconz_module.group_material_request_user,silliconz_module.group_material_request_approver"/>

</odoo>