<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_users_form_signature" model="ir.ui.view">
        <field name="name">res.users.form.signature</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">

            <!-- Add inside Preferences or any group -->
            <xpath expr="//sheet/notebook/page[@name='preferences']/group" position="inside">
                <group string="Signature">
                    <field name="signature_image" widget="image" class="oe_avatar"/>
                </group>
            </xpath>

        </field>
    </record>
</odoo>
