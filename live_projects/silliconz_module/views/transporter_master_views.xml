<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════
         FORM VIEW
    ══════════════════════════════════════════════ -->
    <record id="view_transporter_master_form" model="ir.ui.view">
        <field name="name">transporter.master.form</field>
        <field name="model">transporter.master</field>
        <field name="arch" type="xml">
            <form string="Transporter">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Transporter Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Contact Details">
                            <field name="contact_person"/>
                            <field name="phone"/>
                            <field name="mobile"/>
                            <field name="email"/>
                        </group>
                        <group string="Business Info">
                            <field name="gstin" string="GSTIN"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Address">
                        <field name="address" nolabel="1" placeholder="Full address..."/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Additional notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════
         LIST VIEW
    ══════════════════════════════════════════════ -->
    <record id="view_transporter_master_list" model="ir.ui.view">
        <field name="name">transporter.master.list</field>
        <field name="model">transporter.master</field>
        <field name="arch" type="xml">
            <list string="Transporters">
                <field name="name"/>
                <field name="contact_person"/>
                <field name="phone"/>
                <field name="mobile"/>
                <field name="email"/>
                <field name="gstin"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════
         SEARCH VIEW
    ══════════════════════════════════════════════ -->
    <record id="view_transporter_master_search" model="ir.ui.view">
        <field name="name">transporter.master.search</field>
        <field name="model">transporter.master</field>
        <field name="arch" type="xml">
            <search string="Transporters">
                <field name="name"/>
                <field name="contact_person"/>
                <field name="phone"/>
                <field name="gstin"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Archived" name="archived" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════
         WINDOW ACTION
    ══════════════════════════════════════════════ -->
    <record id="action_transporter_master" model="ir.actions.act_window">
        <field name="name">Transporters</field>
        <field name="res_model">transporter.master</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_transporter_master_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first transporter!
            </p>
        </field>
    </record>

</odoo>
