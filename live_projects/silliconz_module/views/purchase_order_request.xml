<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="purchase_request_form_view" model="ir.ui.view">
        <field name="name">purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">

            <form string="Purchase Request">
                <header>
            
                    <button name="action_submit"
                            string="Submit"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            groups="silliconz_module.group_purchase_request_user, silliconz_module.group_purchase_request_manager"/>

            
                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'submitted'"
                            groups="silliconz_module.group_purchase_request_manager"/>

                    <!-- Create PO (Wizard) -->
                    <button name="action_open_create_po_wizard"
                            string="Create PO"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'approved'"
                            groups="silliconz_module.group_purchase_order_salesperson,silliconz_module.group_purchase_request_manager"/>

                    <!-- Reset to Draft -->
                    <button name="action_reset_draft"
                            string="Reset to Draft"
                            type="object"
                            class="btn-secondary"
                            invisible="state == 'draft'"/>

                    <field name="state" widget="statusbar"
                            statusbar_visible="draft,submitted,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase_orders"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-shopping-cart"
                                invisible="purchase_order_count == 0"
                                groups="silliconz_module.group_purchase_request_user,silliconz_module.group_purchase_request_manager">
                            <field name="purchase_order_count"
                                    widget="statinfo"
                                    string="Purchase Orders"/>
                        </button>


                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="material_request_id"
                                string="Material Request Ref"
                                readonly="1"/>
                        </group>

                        <group>
                            <field name="mo_id"
                            string="Source Document"
                            />
                            <field name="analytic_account_id" options="{'no_create': True}"/>
                            <field name="expected_date"/> 
                            <field name="received_date"/>
                            <field name="pr_requestor_id" invisible="1"/>
                            <field name="pr_approver_id" invisible="1" />

                        </group>

                    </group>

                    <notebook>
                        <page string="Products">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="manufacturer_ids" string="Manufacturers"
                                            domain="[('id', 'in', allowed_manufacturer_ids)]"
                                            options="{'no_open': True, 'no_create_edit': True}"
                                            />
                                    <field name="manufacturer_part_number_ids" string="Part Numbers"
                                            domain="[('id', 'in', allowed_part_number_ids)]"
                                            context="{'default_product_tmpl_id': product_tmpl_id, 'default_manufacturer_id': manufacturer_ids}"
                                            options="{'no_open': True, 'no_create_edit': True}"/>
                                    
                                    <field name="product_tmpl_id" invisible="1"/>
                                    
                                    
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
                <chatter/>
            </form>

        </field>
    </record>
    <record id="purchase_request_tree_view" model="ir.ui.view">
        <field name="name">purchase.request.tree</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="material_request_id"/>
                <field name="mo_id" string="Source Document"/>
                <field name="state" widget="badge"
                        decoration-info="state == 'draft'"
                        decoration-warning="state == 'submitted'"
                        decoration-success="state in ('approved', 'done')"/>
            </list>
        </field>
    </record>


    <!-- Action -->
    <record id="action_purchase_request" model="ir.actions.act_window">
        <field name="name">Purchase Requests</field>
        <field name="res_model">purchase.request</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- Menu -->
    <menuitem id="menu_purchase_request_root"
                name="Purchase Request"
                sequence="30"/>

    <menuitem id="menu_purchase_request"
                name="Requests"
                parent="menu_purchase_request_root"
                action="action_purchase_request"
                sequence="10"/>

</odoo>