<odoo>
    <record id="mrp_production_form_inherit" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="sale_order_id" readonly="1"/>
                <field name="customer_po_reference" readonly="1"/>
                <field name="material_request_id" readonly="1"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_material_requests"
                            type="object"
                            string="Material Requests"
                            class="btn-secondary"
                            icon="fa-list"
                            invisible="material_request_count == 0">
                        <field name="material_request_count"
                                widget="statinfo"
                                string="Material Requests"/>
                    </button>
                </xpath>
        </field>
    </record>
</odoo>

