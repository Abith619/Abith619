<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="custom_standard_layout" inherit_id="web.external_layout_standard">
        <xpath expr="//div[contains(@t-attf-class, 'header')]" position="replace">
            <div t-attf-class="header o_company_#{company.id}_layout" style="margin: 0; padding: 0;">
                <table style="width: 100%; border-collapse: collapse; border: 1px solid #000; font-size: 11px; margin-bottom: 6px;">
                    <tr>
                        <!-- Company Logo -->
                        <td style="width: 20%; border-right: 1px solid #000; padding: 6px; text-align: center; vertical-align: middle;">
                            <img t-if="company.logo"
                                t-att-src="image_data_uri(company.logo)"
                                style="max-height: 90px; max-width: 100%;"
                                alt="Logo"/>
                        </td>

                        <!-- Company Details -->
                        <td style="width: 60%; border-right: 1px solid #000; padding: 6px; text-align: left; vertical-align: middle;">
                            <div style="font-size: 15px; font-weight: bold; font-style: italic; margin-bottom: 3px;">
                                <span t-field="company.name"/>
                            </div>
                            <div>
                                <t t-if="company.street"><span t-field="company.partner_id.street"/></t>
                                <t t-if="company.street2">, <span t-field="company.partner_id.street2"/></t>
                                <t t-if="company.city"> <span t-field="company.partner_id.city"/></t>
                                <t t-if="company.zip"> - <span t-field="company.partner_id.zip"/></t>
                            </div>
                            <div>
                                <t t-if="company.phone">Tel: <span t-field="company.phone"/></t>
                                <t t-if="company.email"> | Email: <span t-field="company.email"/></t>
                            </div>
                            <div>
                                <t t-if="company.vat">GSTIN: <span t-field="company.vat"/></t>
                                <t t-if="company.company_registry"> | PAN No: <span t-field="company.company_registry"/></t>
                            </div>
                            <div>
                                <t t-if="company.website">Website: <span t-field="company.website"/></t>
                            </div>
                        </td>

                        <!-- ISO Logo -->
                        <td style="width: 20%; padding: 6px; text-align: center; vertical-align: middle;">
                            <img src="/silliconz_module/static/src/img/iso.jpg"
                                style="max-height: 90px; max-width: 100%;"
                                alt="ISO 9001"/>
                        </td>
                    </tr>
                </table>
            </div>
        </xpath>

        <xpath expr="//div[contains(@class, 'o_footer')]" position="replace">
            <div class="custom_footer text-center" style="border-top: 1px solid black; padding-top: 4px; font-size: 10px;">
                <strong><t t-esc="company.name"/></strong>
                <span style="margin: 0 8px;">|</span>
                <t t-esc="company.partner_id.street"/>
                <t t-if="company.partner_id.city">, <t t-esc="company.partner_id.city"/></t>
                <t t-if="company.partner_id.country_id.name">, <t t-esc="company.partner_id.country_id.name"/></t>
                <span style="margin: 0 8px;">|</span>
                Page: <span class="page"/> / <span class="topage"/>
            </div>
        </xpath>
    </template>
</odoo>