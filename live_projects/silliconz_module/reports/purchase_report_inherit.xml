<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="report_custom_purchase_order">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
                <t t-call="silliconz_module.report_custom_purchase_order_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>

    <template id="report_custom_purchase_order_document">
        <t t-call="web.basic_layout">
            <div class="page" style="font-size: 11px; margin: 0; padding: 0; font-family: 'Italic', sans-serif;">
                
                <!-- ===== COMPANY HEADER (No Borders) ===== -->
                <table style="width: 100%; border: none; margin-bottom: 5px;">
                    <colgroup>
                        <col style="width: 25%;"/>
                        <col style="width: 55%;"/>
                        <col style="width: 20%;"/>
                    </colgroup>
                    <tr>
                        <!-- Company Logo -->
                        <td style="padding: 4px; text-align: left; vertical-align: top;">
                            <img t-if="o.company_id.logo"
                                t-att-src="image_data_uri(o.company_id.logo)"
                                style="max-height: 80px; max-width: 100%;"
                                alt="Logo"/>
                        </td>

                        <!-- Company Details -->
                        <td style="padding: 4px; text-align: left; vertical-align: top;">
                            <div style="font-size: 15px; font-weight: bold; font-style: italic; margin-bottom: 2px;">
                                <span t-field="o.company_id.name"/>
                            </div>
                            <div style="font-size: 10px;">
                                <t t-if="o.company_id.street"><span t-field="o.company_id.street"/></t>
                                <t t-if="o.company_id.street2">, <span t-field="o.company_id.street2"/></t>
                                <t t-if="o.company_id.city"> <span t-field="o.company_id.city"/></t>
                                <t t-if="o.company_id.zip"> - <span t-field="o.company_id.zip"/></t>
                                <t t-if="o.company_id.state_id"> <span t-field="o.company_id.state_id.name"/></t>
                                <t t-if="o.company_id.country_id"> <span t-field="o.company_id.country_id.name"/></t>
                            </div>
                            <div style="font-size: 10px;">
                                <t t-if="o.company_id.phone">Tel: <span t-field="o.company_id.phone"/></t>
                                <t t-if="o.company_id.email"> | Email: <span t-field="o.company_id.email"/></t>
                            </div>
                            <div style="font-size: 10px;">
                                <t t-if="o.company_id.vat">GSTIN: <span t-field="o.company_id.vat"/></t>
                                <t t-if="o.company_id.company_registry"> | PAN: <span t-field="o.company_id.company_registry"/></t>
                            </div>
                            <div style="font-size: 10px;">
                                <t t-if="o.company_id.website">Website: <span t-field="o.company_id.website"/></t>
                            </div>
                        </td>

                        <!-- ISO Logo -->
                        <td style="padding: 4px; text-align: right; vertical-align: top;">
                            <img src="/silliconz_module/static/src/img/iso.jpg"
                                style="max-height: 100px; max-width: 100%;"
                                alt="ISO 9001"/>
                        </td>
                    </tr>
                </table>
                
                <!-- Title (Centered tightly between flat lines) -->
                <div style="text-align: center; font-weight: bold; font-size: 14px; border-top: 1.5px solid #000; border-bottom: 1px solid #000; padding: 4px 0; margin-bottom: 8px;">
                    PURCHASE ORDER
                </div>

                <!-- PO Header Info Table (No Internal Borders) -->
                <table style="font-size: 10px; width: 100%; margin-bottom: 10px; border: none;">
                    <colgroup>
                        <col style="width: 15%;"/>
                        <col style="width: 35%;"/>
                        <col style="width: 20%;"/>
                        <col style="width: 30%;"/>
                    </colgroup>
                    <tr>
                        <td style="padding: 2px;"><strong>PO No</strong></td>
                        <td style="padding: 2px;"><span t-field="o.name"/></td>
                        <td style="padding: 2px;"><strong>PO Date</strong></td>
                        <td style="padding: 2px;">
                            <t t-if="o.state == 'purchase' and o.date_approve">
                                <span t-field="o.date_approve" t-options="{'widget': 'date', 'format': 'dd-MMM-yyyy'}"/>
                            </t>
                            <t t-else="">
                                <span t-field="o.date_order" t-options="{'widget': 'date', 'format': 'dd-MMM-yyyy'}"/>
                            </t>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 2px;"><strong>Supplier</strong></td>
                        <td style="padding: 2px;"><span t-field="o.partner_id.name"/></td>
                        <td style="padding: 2px;"><strong>GSTIN</strong></td>
                        <td style="padding: 2px;"><span t-field="o.partner_id.vat"/></td>
                    </tr>
                    <tr>
                        <td style="padding: 2px; vertical-align: top;"><strong>Address</strong></td>
                        <td style="padding: 2px; vertical-align: top;">
                            <span t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                        </td>
                        <td style="padding: 2px; vertical-align: top;"><strong>Payment Terms (Days)</strong></td>
                        <td style="padding: 2px; vertical-align: top;"><span t-field="o.payment_term_id.name"/></td>
                    </tr>
                    <tr>
                        <td style="padding: 2px;"><strong>Currency</strong></td>
                        <td style="padding: 2px;"><span t-field="o.currency_id.name"/></td>
                        <td style="padding: 2px;"><strong>Exchange Rate</strong></td>
                        <td style="padding: 2px;"><span t-field="o.currency_rate"/></td>
                    </tr>
                    <tr>
                        <td style="padding: 2px;"><strong>Delivery Date<br/>(On or Before)</strong></td>
                        <td style="padding: 2px;">
                            <span t-if="o.date_planned" t-field="o.date_planned" t-options="{'widget': 'date', 'format': 'dd-MMM-yyyy'}"/>
                        </td>
                        <td style="padding: 2px;"></td>
                        <td style="padding: 2px;"></td>
                    </tr>
                    <tr>
                        <td style="padding: 2px;"><strong>Your Ref No</strong></td>
                        <td style="padding: 2px;"><span t-field="o.partner_ref"/></td>
                        <td style="padding: 2px;"><strong>Ref Date</strong></td>
                        <td style="padding: 2px;">
                            <span t-if="o.reference_date" t-field="o.reference_date" t-options="{'widget': 'date', 'format': 'dd-MMM-yyyy'}"/>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 2px;"><strong>Contact Person</strong></td>
                        <td style="padding: 2px;"><span t-field="o.user_id.name"/></td>
                        <td style="padding: 2px;"><strong>Contact Number</strong></td>
                        <td style="padding: 2px;"><span t-field="o.user_id.phone"/></td>
                    </tr>
                    <tr>
                        <td style="padding: 2px; vertical-align: top;"><strong>Bill To</strong></td>
                        <td style="padding: 2px; vertical-align: top;">
                            <t t-if="o.billing_address_id">
                                <span t-field="o.billing_address_id" t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": True}'/>
                            </t>
                            <t t-else="">
                                <span t-field="o.company_id.partner_id" t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": True}'/>
                            </t>
                        </td>
                        <td style="padding: 2px; vertical-align: top;"><strong>Ship To</strong></td>
                        <td style="padding: 2px; vertical-align: top;">
                            <t t-if="o.shipping_address_id">
                                <span t-field="o.shipping_address_id" t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": True}'/>
                            </t>
                            <t t-elif="o.dest_address_id">
                                <span t-field="o.dest_address_id" t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": True}'/>
                            </t>
                            <t t-else="">
                                <span t-field="o.company_id.partner_id" t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": True}'/>
                            </t>
                        </td>
                    </tr>
                </table>

                <!-- Line Items Table (Bordered) -->
                <table style="font-size: 9px; width: 100%; border-collapse: collapse; margin-top: 5px;">
                    <thead>
                        <tr>
                            <th style="text-align: center; padding: 2px; width: 4%; border: 1px solid #000;">Sl<br/>No</th>
                            <th style="text-align: center; padding: 2px; width: 12%; border: 1px solid #000;">Item Code</th>
                            <th style="text-align: left; padding: 2px; width: 16%; border: 1px solid #000;">Item Description</th>
                            <th style="text-align: center; padding: 2px; width: 14%; border: 1px solid #000;">M.Part Number -<br/>Manufacturer</th>
                            <th style="text-align: center; padding: 2px; width: 8%; border: 1px solid #000;">Additional<br/>Info</th>
                            <th style="text-align: center; padding: 2px; width: 8%; border: 1px solid #000;">HSN / SAC Code</th>
                            <th style="text-align: center; padding: 2px; width: 5%; border: 1px solid #000;">Qty</th>
                            <th style="text-align: center; padding: 2px; width: 5%; border: 1px solid #000;">Unit</th>
                            <th style="text-align: right; padding: 2px; width: 7%; border: 1px solid #000;">Rate</th>
                            <th style="text-align: center; padding: 2px; width: 5%; border: 1px solid #000;">Discount</th>
                            <th style="text-align: right; padding: 2px; width: 7%; border: 1px solid #000;">Final<br/>Rate</th>
                            <th style="text-align: right; padding: 2px; width: 9%; border: 1px solid #000;">Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="line_index" t-value="0"/>
                        <t t-foreach="o.order_line.filtered(lambda l: not l.display_type)" t-as="line">
                            <t t-set="line_index" t-value="line_index + 1"/>
                            <tr>
                                <td style="text-align: center; padding: 2px; border: 1px solid #000;"><t t-out="line_index"/></td>
                                <td style="text-align: center; padding: 2px; border: 1px solid #000;"><span t-field="line.product_id.default_code"/></td>
                                <td style="text-align: left; padding: 2px; border: 1px solid #000;"><span t-field="line.name"/></td>
                                <td style="text-align: center; padding: 2px; border: 1px solid #000;">
                                    <t t-if="line.manufacturer_part_number_ids">
                                        <span t-field="line.manufacturer_part_number_ids.part_number"/>
                                    </t>
                                    <t t-if="line.manufacturer_ids">
                                        - <span t-out="line.manufacturer_ids.manufacturer"/>
                                    </t>
                                </td>
                                <td style="text-align: center; padding: 2px; border: 1px solid #000;">
                                    <t t-if="line.additional_info">
                                        <span t-field="line.additional_info"/>
                                    </t>
                                </td>
                                <td style="text-align: center; padding: 2px; border: 1px solid #000;">
                                    <span t-if="line.product_id.l10n_in_hsn_code" t-field="line.product_id.l10n_in_hsn_code"/>
                                </td>
                                <td style="text-align: center; padding: 2px; border: 1px solid #000;"><span t-out="int(line.product_qty)"/></td>
                                <td style="text-align: center; padding: 2px; border: 1px solid #000;">
                                    <t t-if="line.product_uom_id.name == 'Units'">NOS</t>
                                    <t t-else=""><span t-field="line.product_uom_id.name"/></t>
                                </td>
                                <td style="text-align: right; padding: 2px; border: 1px solid #000;"><span t-out="'%.2f' % line.price_unit"/></td>
                                <td style="text-align: center; padding: 2px; border: 1px solid #000;"><span t-out="int(line.discount)"/></td>
                                <td style="text-align: right; padding: 2px; border: 1px solid #000;">
                                    <span t-out="'%.2f' % (line.price_unit * (1 - line.discount / 100))"/>
                                </td>
                                <td style="text-align: right; padding: 2px; border: 1px solid #000;">
                                    <span t-out="'{:,.2f}'.format(line.price_subtotal)"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- Tax Summary Table (Right aligned, completely bordered) -->
                <table style="width: 100%; border-collapse: collapse; margin-top: 4px;">
                    <tr>
                        <td style="width: 48%;"></td>
                        <td style="width: 52%; vertical-align: top;">
                            <table style="font-size: 9px; width: 100%; border-collapse: collapse;">
                                <thead>
                                    <tr>
                                        <th style="text-align: left; padding: 2px 4px; border: 1px solid #000;">Tax Type</th>
                                        <th style="text-align: right; padding: 2px 4px; border: 1px solid #000;">Taxable Amount</th>
                                        <th style="text-align: right; padding: 2px 4px; border: 1px solid #000;">Tax Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="tax_groups" t-value="{}"/>
                                    <t t-foreach="o.order_line.filtered(lambda l: not l.display_type)" t-as="tline">
                                        <t t-foreach="tline.tax_ids" t-as="tax">
                                            <t t-set="tax_key" t-value="tax.name"/>
                                            <t t-if="tax_key not in tax_groups">
                                                <t t-set="_" t-value="tax_groups.update({tax_key: {'base': 0, 'amount': 0}})"/>
                                            </t>
                                            <t t-set="_" t-value="tax_groups[tax_key].update({'base': tax_groups[tax_key]['base'] + tline.price_subtotal, 'amount': tax_groups[tax_key]['amount'] + tline.price_tax})"/>
                                        </t>
                                    </t>
                                    <t t-foreach="tax_groups" t-as="tg">
                                        <tr>
                                            <td style="text-align: left; padding: 2px 4px; border: 1px solid #000;"><t t-out="tg"/></td>
                                            <td style="text-align: right; padding: 2px 4px; border: 1px solid #000;">
                                                <span t-out="'{:,.2f}'.format(tax_groups[tg]['base'])"/>
                                            </td>
                                            <td style="text-align: right; padding: 2px 4px; border: 1px solid #000;">
                                                <span t-out="'{:,.2f}'.format(tax_groups[tg]['amount'])"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <table style="font-size: 9px; width: 100%; border-collapse: collapse; margin-top: 4px;">
                                <tr>
                                    <td style="text-align: center; font-weight: bold; padding: 2px; border: 1px solid #000;">
                                        Basic
                                    </td>
                                    <td style="text-align: center; font-weight: bold; padding: 2px; border: 1px solid #000;">
                                        Total Tax
                                    </td>
                                    <td style="text-align: right; font-weight: bold; padding: 2px; border: 1px solid #000;">
                                        Grand Total(<t t-out="o.currency_id.name"/>)
                                    </td>
                                </tr>
                                <tr>
                                    <td style="text-align: center; font-weight: bold; padding: 2px; border: 1px solid #000;">
                                        <span t-out="'{:,.2f}'.format(o.amount_untaxed)"/>/-
                                    </td>
                                    <td style="text-align: center; font-weight: bold; padding: 2px; border: 1px solid #000;">
                                        <span t-out="'{:,.2f}'.format(o.amount_tax)"/>/-
                                    </td>
                                    <td style="text-align: right; font-weight: bold; padding: 2px; border: 1px solid #000;">
                                        <span t-out="'{:,.2f}'.format(o.amount_total)"/>/-
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>

                <!-- Amount In Words -->
                <div style="margin-top: 10px; font-weight: bold; font-size: 10px;">
                    Amount In Words <t t-if="o.currency_id.name == 'INR'">Rupees</t> <t t-if="o.amount_in_words">
                        <span style="text-transform: capitalize;" t-field="o.amount_in_words"/> Only/-
                    </t>
                </div>

                <!-- Additional Comments -->
                <div style="margin-top: 5px; font-weight: bold; font-size: 10px;">
                    Additional comments&#160;&#160;&#160;&#160;&#160;
                    <t t-if="o.additional_comments">
                        <span style="font-weight: normal;" t-field="o.additional_comments"/>
                    </t>
                    <t t-else="">-</t>
                </div>

                <!-- Terms and Conditions Block (Full Border Box) -->
                <t t-if="o.note">
                    <table style="width: 100%; border-collapse: collapse; margin-top: 15px; page-break-inside: avoid; font-size: 10px;">
                        <tr>
                            <td style="border: 1px solid #000; text-align: center; font-weight: bold; padding: 3px;">
                                TERMS AND CONDITIONS
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid #000; padding: 5px;">
                                <div t-field="o.note"/>
                            </td>
                        </tr>
                    </table>
                </t>

                <!-- Signature Block -->
                <table style="width: 100%; margin-top: 30px; page-break-inside: avoid; border: none;">
                    <tr>
                        <td style="width: 60%; vertical-align: bottom;">
                            <div style="font-size: 8px; font-weight: bold;">
                                This is a electronically generated Document
                            </div>
                        </td>
                        <td style="width: 40%; text-align: center; vertical-align: bottom;">
                            <div style="font-weight: bold; font-size: 11px;">
                                For <span t-field="o.company_id.name"/>
                            </div>
                            <br/><br/>
                            <t t-if="o.po_approver_signature">
                                <img t-att-src="image_data_uri(o.po_approver_signature)"
                                    style="max-height: 50px; max-width: 150px;"
                                    alt="Approver Signature"/>
                            </t>
                            <br/>
                            <div style="border-top: 1px solid #000; width: 100%; margin: 5px auto 0; padding-top: 2px;">
                                <div style="font-size: 9px; font-weight: bold;">Authorized Signatory</div>
                            </div>
                        </td>
                    </tr>
                </table>

            </div>
        </t>
    </template>
</odoo>