<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Main Template for Material Request -->
    <template id="report_material_request">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="silliconz_module.report_material_request_document"/>
            </t>
        </t>
    </template>

    <!-- Sale Order → Material Requests wrapper template -->
    <template id="report_sale_order_material_requests">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="sale">
                <t t-set="related_mrs" t-value="env['material.request'].search([('sale_order_id', '=', sale.id)])"/>
                <t t-if="related_mrs">
                    <t t-foreach="related_mrs" t-as="o">
                        <t t-call="silliconz_module.report_material_request_document"/>
                    </t>
                </t>
                <t t-else="">
                    <t t-call="web.basic_layout">
                        <div class="page" style="text-align:center; padding: 40px; font-size: 14px;">
                            No Material Requests found for Sale Order <strong t-out="sale.name"/>.
                        </div>
                    </t>
                </t>
            </t>
        </t>
    </template>

    <template id="report_material_request_document">
        <t t-call="web.basic_layout">
            <div class="page" style="font-size: 11px; margin: 0; padding: 0; font-family: 'Italic', sans-serif;">

                <!-- ===== COMPANY HEADER ===== -->
                <table style="width: 100%; border: none; margin-bottom: 5px;">
                    <colgroup>
                        <col style="width: 25%;"/>
                        <col style="width: 55%;"/>
                        <col style="width: 20%;"/>
                    </colgroup>
                    <tr>
                        <!-- Company Logo -->
                        <td style="padding: 4px; text-align: left; vertical-align: top;">
                            <img t-if="res_company.logo"
                                t-att-src="image_data_uri(res_company.logo)"
                                style="max-height: 100px; max-width: 100%;"
                                alt="Logo"/>
                        </td>

                        <!-- Company Details -->
                        <td style="padding: 4px; text-align: left; vertical-align: top;">
                            <div style="font-size: 15px; font-weight: bold; font-style: italic; margin-bottom: 2px;">
                                <span t-field="res_company.name"/>
                            </div>
                            <div style="font-size: 10px;">
                                <t t-if="res_company.street"><span t-field="res_company.street"/></t>
                                <t t-if="res_company.street2">, <span t-field="res_company.street2"/></t>
                                <t t-if="res_company.city"> <span t-field="res_company.city"/></t>
                                <t t-if="res_company.zip"> - <span t-field="res_company.zip"/></t>
                                <t t-if="res_company.state_id"> <span t-field="res_company.state_id.name"/></t>
                                <t t-if="res_company.country_id"> <span t-field="res_company.country_id.name"/></t>
                            </div>
                            <div style="font-size: 10px;">
                                <t t-if="res_company.phone">Tel: <span t-field="res_company.phone"/></t>
                                <t t-if="res_company.email"> | Email: <span t-field="res_company.email"/></t>
                            </div>
                        </td>

                        <!-- ISO Logo -->
                        <td style="padding: 4px; text-align: right; vertical-align: top;">
                            <img src="/silliconz_module/static/src/img/iso.jpg"
                                style="max-height: 100px; max-width: 100%;"
                                alt="ISO 9001"/>
                        </td>
                    </tr>
                </table>

                <!-- ===== TITLE ===== -->
                <div style="text-align: center; font-weight: bold; font-size: 14px; border-top: 1.5px solid #000; border-bottom: 1px solid #000; padding: 4px 0; margin-bottom: 8px;">
                    MATERIALS REQUEST FORM
                </div>

                <!-- ===== MR HEADER INFO (matches physical form layout) ===== -->
                <table style="font-size: 10px; width: 100%; margin-bottom: 10px; border-collapse: collapse;">
                    <colgroup>
                        <col style="width: 12%;"/>
                        <col style="width: 33%;"/>
                        <col style="width: 15%;"/>
                        <col style="width: 40%;"/>
                    </colgroup>
                    <tr>
                        <td style="padding: 2px;"><strong>MR Number</strong></td>
                        <td style="padding: 2px;"><span t-field="o.name"/></td>
                        <td style="padding: 2px;"><strong>PR Number</strong></td>
                        <td style="padding: 2px;">
                            <t t-if="o.purchase_request_ids">
                                <t t-foreach="o.purchase_request_ids" t-as="pr">
                                    <span t-field="pr.name"/>
                                    <t t-if="not pr_last">, </t>
                                </t>
                            </t>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 2px;"><strong>MR Date</strong></td>
                        <td style="padding: 2px;">
                            <span t-if="o.request_date" t-field="o.request_date" t-options="{'widget': 'date', 'format': 'dd/MM/yy'}"/>
                        </td>
                        <td style="padding: 2px;"><strong>PR Date</strong></td>
                        <td style="padding: 2px;">
                            <t t-if="o.purchase_request_ids">
                                <span t-field="o.purchase_request_ids[0].expected_date" t-options="{'widget': 'date', 'format': 'dd/MM/yy'}"/>
                            </t>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 2px;"><strong>Project / Code Name</strong></td>
                        <td style="padding: 2px;">
                            <t t-if="o.analytic_account_id">
                                <span t-out="o.analytic_account_id.name"/>
                            </t>
                            <t t-elif="o.sale_order_id">
                                <span t-out="o.sale_order_id.name"/>
                            </t>
                            <t t-elif="o.mo_id">
                                <span t-out="o.mo_id.name"/>
                            </t>
                        </td>
                        <td style="padding: 2px;"><strong>Remarks</strong></td>
                        <td style="padding: 2px;">
                            <span t-if="o.remarks" t-field="o.remarks"/>
                        </td>
                    </tr>
                </table>

                <!-- ===== LINE ITEMS TABLE ===== -->
                <table style="font-size: 9px; width: 100%; border-collapse: collapse; margin-top: 5px;">
                    <thead>
                        <tr>
                            <th style="text-align: center; padding: 2px; width: 4%; border: 1px solid #000;">Sl.No</th>
                            <th style="text-align: center; padding: 2px; width: 12%; border: 1px solid #000;">Siliconz Code</th>
                            <th style="text-align: left; padding: 2px; width: 24%; border: 1px solid #000;">Materials Description</th>
                            <th style="text-align: center; padding: 2px; width: 14%; border: 1px solid #000;">Mtr. Part Number</th>
                            <th style="text-align: center; padding: 2px; width: 12%; border: 1px solid #000;">Manufacturer (Mftr)</th>
                            <th style="text-align: center; padding: 2px; width: 6%; border: 1px solid #000;">Req QTY</th>
                            <th style="text-align: center; padding: 2px; width: 6%; border: 1px solid #000;">Issued QTY</th>
                            <th style="text-align: center; padding: 2px; width: 10%; border: 1px solid #000;">Issued Date</th>
                            <th style="text-align: left; padding: 2px; width: 12%; border: 1px solid #000;">Purpose / Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="line_index" t-value="0"/>
                        <t t-foreach="o.line_ids" t-as="line">
                            <t t-set="line_index" t-value="line_index + 1"/>
                            <tr>
                                <td style="text-align: center; padding: 2px; border: 1px solid #000;"><t t-out="line_index"/></td>
                                <td style="text-align: center; padding: 2px; border: 1px solid #000;">
                                    <span t-if="line.product_id.default_code" t-out="line.product_id.default_code"/>
                                </td>
                                <td style="text-align: left; padding: 2px; border: 1px solid #000;">
                                    <b><span t-out="line.product_id.display_name"/></b>
                                    <t t-if="line.description">
                                        <br/><span style="font-size: 8px;" t-out="line.description"/>
                                    </t>
                                </td>
                                <td style="text-align: center; padding: 2px; border: 1px solid #000;">
                                    <t t-if="line.manufacturer_part_number_ids">
                                        <span t-out="line.manufacturer_part_number_ids.part_number"/>
                                    </t>
                                </td>
                                <td style="text-align: center; padding: 2px; border: 1px solid #000;">
                                    <t t-if="line.manufacturer_ids">
                                        <span t-out="line.manufacturer_ids.manufacturer"/>
                                    </t>
                                </td>
                                <td style="text-align: center; padding: 2px; border: 1px solid #000;">
                                    <span t-out="int(line.requested_qty)"/>
                                </td>
                                <td style="text-align: center; padding: 2px; border: 1px solid #000;">
                                    <t t-if="line.issued_qty">
                                        <span t-out="int(line.issued_qty)"/>
                                    </t>
                                </td>
                                <td style="text-align: center; padding: 2px; border: 1px solid #000;">
                                    <t t-if="line.issued_date">
                                        <span t-field="line.issued_date" t-options="{'widget': 'date', 'format': 'dd/MM/yy'}"/>
                                    </t>
                                </td>
                                <td style="text-align: left; padding: 2px; border: 1px solid #000;">
                                    <t t-if="line.line_remarks">
                                        <span t-field="line.line_remarks"/>
                                    </t>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- ===== SIGNATURE BLOCK (3 columns: Requested By / Approved By / Issued By) ===== -->
                <table style="width: 100%; margin-top: 50px; page-break-inside: avoid; border: none; text-align: center;">
                    <tr>
                        <!-- Requested By -->
                        <td style="width: 33%; vertical-align: bottom; text-align: center;">
                            <t t-if="o.mr_requestor_signature">
                                <img t-att-src="image_data_uri(o.mr_requestor_signature)"
                                    style="max-height: 50px; max-width: 150px;"
                                    alt="Requestor Signature"/>
                            </t>
                            <br/>
                            <div style="border-top: 1px solid #000; width: 70%; margin: 5px auto 0; padding-top: 2px;">
                                <div style="font-size: 10px; font-weight: bold;">Requested By</div>
                                <div style="font-size: 10px;">
                                    <t t-if="o.mr_requestor_id">
                                        <span t-out="o.mr_requestor_id.name"/>
                                    </t>
                                    <t t-elif="o.requester_id">
                                        <span t-out="o.requester_id.name"/>
                                    </t>
                                </div>
                            </div>
                        </td>

                        <!-- Approved By -->
                        <td style="width: 33%; vertical-align: bottom; text-align: center;">
                            <t t-if="o.mr_approver_signature">
                                <img t-att-src="image_data_uri(o.mr_approver_signature)"
                                    style="max-height: 50px; max-width: 150px;"
                                    alt="Approver Signature"/>
                            </t>
                            <br/>
                            <div style="border-top: 1px solid #000; width: 70%; margin: 5px auto 0; padding-top: 2px;">
                                <div style="font-size: 10px; font-weight: bold;">Approved By</div>
                                <div style="font-size: 10px;">
                                    <t t-if="o.mr_approver_id">
                                        <span t-out="o.mr_approver_id.name"/>
                                    </t>
                                </div>
                            </div>
                        </td>

                        <!-- Issued By -->
                        <td style="width: 33%; vertical-align: bottom; text-align: center;">
                            <t t-if="o.mr_issuer_signature">
                                <img t-att-src="image_data_uri(o.mr_issuer_signature)"
                                    style="max-height: 50px; max-width: 150px;"
                                    alt="Issuer Signature"/>
                            </t>
                            <br/>
                            <div style="border-top: 1px solid #000; width: 70%; margin: 5px auto 0; padding-top: 2px;">
                                <div style="font-size: 10px; font-weight: bold;">Issued By</div>
                                <div style="font-size: 10px;">
                                    <t t-if="o.mr_issuer_id">
                                        <span t-out="o.mr_issuer_id.name"/>
                                    </t>
                                </div>
                            </div>
                        </td>
                    </tr>
                </table>

                <!-- Page Info -->
                <div style="text-align: center; font-size: 8px; margin-top: 10px;">
                    Page <span class="page"/> of <span class="topage"/>
                </div>

            </div>
        </t>
    </template>
</odoo>
