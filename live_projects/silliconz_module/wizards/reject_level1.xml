<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_reject_lvl1_wizard_form" model="ir.ui.view">
        <field name="name">reject.lvl1.wizard.form</field>
        <field name="model">reject.lvl1.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Level 1">
                <group>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_confirm_reject"
                            type="object"
                            string="Confirm"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>