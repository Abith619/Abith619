<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bill_validation_wizard_form" model="ir.ui.view">
        <field name="name">bill.validation.wizard.form</field>
        <field name="model">bill.validation.wizard</field>
        <field name="arch" type="xml">
            <form string="Bill Mismatches from PO">
                <group>
                    <field name="message" readonly="1"/>
                </group>
                <footer>
                    <button name="action_validate" string="Amend Order &amp; Try Again" type="object" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>