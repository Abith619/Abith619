<odoo>
    <record id="create_transfer_wizard_form_view" model="ir.ui.view">
        <field name="name">create.transfer.wizard.form</field>
        <field name="model">create.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Transfer">
                <sheet>
                    <group>
                        <field name="material_request_id"/>
                        <field name="source_location_id"/>

                    </group>
                    <notebook>
                        <page string="Products">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="requested_qty"/>
                                    <field name="approved_qty"/>
                                    <field name="available_qty"/>
                                    <field name="uom_id"/>
                                    <field name="destination_location_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <footer>
                        <button string="Confirm" type="object" name="action_confirm_transfer" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
