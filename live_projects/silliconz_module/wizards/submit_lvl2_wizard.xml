<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_submit_level2_wizard_form" model="ir.ui.view">
    <field name="name">submit.level2.wizard.form</field>
    <field name="model">submit.level2.wizard</field>
    <field name="arch" type="xml">
            <form string="Submit for Level 2 Approval">
                <group>
                    <field name="sale_id" invisible="1"/>
                    <field name="customer_po_reference" required="1"/>
                    <field name="customer_po_date" required="1"/>
                    <field name="customer_po_attachment"
                        filename="customer_po_filename"/>
                    <field name="customer_po_filename" invisible="1"/>
                </group>

                <footer>
                    <button name="action_confirm_submit"
                            string="Submit"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>




</odoo>
