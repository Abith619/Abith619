<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_po_moq_conflict_wizard_form" model="ir.ui.view">
        <field name="name">po.moq.conflict.wizard.form</field>
        <field name="model">po.moq.conflict.wizard</field>
        <field name="arch" type="xml">
            <form string="MOQ Conflict Detected">
                <group>
                    <label for="message" string="The following products have MOQ conflicts:"/>
                    <field name="message" nolabel="1" readonly="1" widget="text"/>
                </group>
                <footer>
                    <button name="action_update_pr_qty"
                            type="object"
                            string="Update PR Quantity"
                            class="btn-primary"
                            data-hotkey="q"/>

                    <button name="action_update_vendor_qty"
                            type="object"
                            string="Update Vendor MOQ"
                            class="btn-secondary"
                            data-hotkey="v"/>

                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            class="btn-link"
                            data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>