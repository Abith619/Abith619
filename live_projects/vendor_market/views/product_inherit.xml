<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id='product_inherit_custom' model='ir.ui.view'>
        <field name='name'>product.template.inherit.custom</field>
        <field name='model'>product.template</field>
        <field name='inherit_id' ref='product.product_template_only_form_view'/>
        <field name='arch' type='xml'>
            <xpath expr="//field[@name='name']" position="after">
                <field name="vendor_ids" widget="many2one" options="{'no_create': True}" context="{'default_is_vendor': True}"/>
            </xpath>
        </field>
    </record>

