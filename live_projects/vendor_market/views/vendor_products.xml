<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template name="Vendor Products" t-name="vendor_market.my_products_page">
       <t t-call="website.layout">
            <section class="container my-5">
                <style>
                    .card-img-top{
                        height: -webkit-fill-available !important;
                    }
                </style>
                <h1 class='text-center'><t t-esc="user_id.name"/></h1>
                <a href="/my/products/create" class="btn btn-primary mb-3">Add Product</a>
                <div class="row">
                    <t t-foreach="products" t-as="product">
                        <div class="col-md-3 mb-4">
                            <div class="card shadow-sm h-100">
                                <img t-att-src="'/web/image/product.template/' + str(product.id) + '/image_1920'" class="card-img-top"/>
                                <div class="card-body">
                                    <h5 class="card-title"><t t-esc="product.name"/></h5>
                                    <p class="card-text">₹ <t t-esc="product.list_price"/></p>
                                    <a t-att-href="'/my/products/%s/edit' % product.id" class="btn btn-sm btn-warning">Edit</a>
                                    <a t-att-href="'/my/products/%s/delete' % product.id" class="btn btn-sm btn-danger">Delete</a>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </section>
        </t>
    </template>

    <template name="Add Product" t-name="vendor_market.create_product_page">
        <t t-call="website.layout">
            <section class="container my-5">
                <h2>Create Product</h2>
                <form method="post" action="/my/products/create" enctype="multipart/form-data">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <div class="mb-3">
                        <label>Name</label>
                        <input type="text" name="name" class="form-control" required='1'/>
                    </div>

                    <div class="mb-3">
                        <label>Price</label>
                        <input type="number" step="0.01" name="list_price" class="form-control" required='1'/>
                    </div>

                    <div class="mb-3">
                        <label>Category</label>
                        <select name="categ_id" class="form-control">
                            <option value="">Select Category</option>
                            <t t-foreach="categories" t-as="cat">
                                <option t-att-value="cat.id"><t t-esc="cat.display_name"/></option>
                            </t>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label>Main Image</label>
                        <input type="file" name="image_1920" class="form-control" accept="image/*"/>
                    </div>

                    <div class="mb-3">
                        <label>Extra Images</label>
                        <input type="file" name="extra_images" class="form-control" accept="image/*" multiple='1'/>
                    </div>

                    <button type="submit" class="btn btn-success">Save</button>
                </form>
            </section>
        </t>
    </template>

    <template name="Edit Product" t-name="vendor_market.edit_product_page">
       <t t-call="website.layout">
            <section class="container my-5">
                <h2>Edit Product</h2>
                <form method="post" t-att-action="'/my/products/%s/edit' % product.id" enctype="multipart/form-data">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <!-- Product Name -->
                    <div class="mb-3">
                        <label for="name" class="form-label">Product Name</label>
                        <input type="text" id="name" name="name" class="form-control"
                            t-att-value="product.name"/>
                    </div>

                    <!-- Price -->
                    <div class="mb-3">
                        <label for="list_price" class="form-label">Price</label>
                        <input type="number" step="0.01" id="list_price" name="list_price" class="form-control"
                            t-att-value="product.list_price"/>
                    </div>

                    <!-- Quantity -->
                    <div class="mb-3">
                        <label class="form-label">Variant Stock</label>
                        <ul>
                            <t t-foreach="product.product_variant_ids" t-as="variant">
                                <li>
                                    <t t-esc="variant.display_name"/> :
                                    <input type="number" name="variant_qty_{{ variant.id }}" class="form-control d-inline w-auto"
                                        t-att-value="variant.qty_available"/>
                                </li>
                            </t>
                        </ul>
                    </div>

                    <!-- Category -->
                    <div class="mb-3">
                        <label for="categ_id" class="form-label">Category</label>
                        <select id="categ_id" name="categ_id" class="form-select">
                            <t t-foreach="request.env['product.category'].sudo().search([])" t-as="cat">
                                <option t-att-value="cat.id"
                                        t-att-selected="'selected' if product.categ_id.id == cat.id else ''">
                                    <t t-esc="cat.name"/>
                                </option>
                            </t>
                        </select>
                    </div>

                    <div class="row">
                        <!-- Product Image -->
                        <div class="mb-3 col-6">
                            <label for="image" class="form-label">Main Product Image</label><br/>
                            <img t-att-src="'/web/image/product.template/' + str(product.id) + '/image_1920'"
                                class="img-thumbnail mb-2" width="150"/>
                            <input type="file" id="image" name="image_1920" class="form-control"/>
                        </div>
                        <div class="col-6">
                            <div class="mb-3">
                                <label class="form-label">Additional Images</label><br/>
                                <div class="d-flex flex-wrap">
                                    <t t-foreach="product.product_template_image_ids" t-as="img">
                                        <div class="position-relative m-1">
                                            <img t-att-src="'/web/image/product.image/' + str(img.id) + '/image_1920'"
                                                class="img-thumbnail m-1" width="100"/>

                                            <a t-att-href="'/my/products/' + str(product.id) + '/delete_image/' + str(img.id)"
                                                class="btn btn-sm btn-danger position-absolute top-0 end-0"
                                                style="padding:2px 6px; border-radius:50%; font-size:12px;">
                                                    <i class="fa fa-trash"></i>
                                            </a>
                                        </div>
                                    </t>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Add Additional Photos</label>
                                <input type="file" name="extra_images" class="form-control" multiple="multiple"/>
                            </div>
                        </div>
                    </div>
                    <!-- Buttons -->
                    <div class="d-flex justify-content-between">
                        <a href="/vendor/products" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-success">Update</button>
                    </div>
                    <div class="alert alert-success" t-if="request.session.get('edit_product_success')">
                        <t t-esc="request.session.pop('edit_product_success')"/>
                    </div>
                </form>
            </section>
        </t>
    </template>

</odoo>