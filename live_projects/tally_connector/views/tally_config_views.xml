<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tally Config Form -->
    <record id="view_tally_config_form" model="ir.ui.view">
        <field name="name">tally.config.form</field>
        <field name="model">tally.config</field>
        <field name="arch" type="xml">
            <form string="Tally Configuration">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="host"/>
                        <field name="port"/>
                        <field name="company_name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_tally_config_list" model="ir.ui.view">
        <field name="name">tally.config.list</field>
        <field name="model">tally.config</field>
        <field name="arch" type="xml">
            <list string="Tally Configurations">
                <field name="name"/>
                <field name="host"/>
                <field name="port"/>
                <field name="company_name"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_tally_config" model="ir.actions.act_window">
        <field name="name">Tally Configuration</field>
        <field name="res_model">tally.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Sync View -->
    <record id="view_tally_sync_form" model="ir.ui.view">
        <field name="name">tally.sync.form</field>
        <field name="model">tally.sync</field>
        <field name="arch" type="xml">
            <form string="Tally Sync">
                <sheet>
                    <group>
                        <field name="name"/>
                        <button name="test_connection" type="object" string="Test Connection" class="btn-primary"/>
                        <field name="last_response" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tally_sync" model="ir.actions.act_window">
        <field name="name">Tally Sync</field>
        <field name="res_model">tally.sync</field>
        <field name="view_mode">form</field>
    </record>
</odoo>
